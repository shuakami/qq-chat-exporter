{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "webui",
  "description": "Let the loopback-hosted QCE WebUI drive its own undecorated window (titlebar controls, account menu actions, external links)",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:event:allow-emit",
    "opener:default"
  ]
}
