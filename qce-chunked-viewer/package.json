{
  "name": "qce-chunked-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HyperScroll-powered viewer for QCE chunked HTML exports. Builds into a single assets/app.js consumed by ModernHtmlTemplates / qq-chat-export-core.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/bundle.mjs",
    "sync": "node scripts/sync-templates.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
